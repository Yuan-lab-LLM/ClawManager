  "components": [],
  "narrative": {
    "northStar": "Fluent 2 Web · 清晰、轻盈、有层次的 Agent 工作台",
    "overview": "默认外观为 Fluent 2 Web 浅色主题，交互强调色为官方 Web 蓝。使用中性表面、清晰字阶、紧凑但可读的控件和分明的浮层。",
    "keyCharacteristics": [
      "通过应用主题、共享 --cm-* 语义变量和 Fluent UI React v9 组件统一呈现。",
      "保留真实品牌图标、32px Agent 图标和鲜明可读的数据图表。",
      "保留单行表格、紧凑工具栏、侧栏边缘折叠和现有业务语义。",
      "Dashboard 优先继续工作及运行概览；Token 与费用在同一绘图区共用时间轴，左右纵轴分别标明单位，只有一笔费用数据时显示一个空心记录点，用量卡片独立切换时间并局部加载；移除主卡片解释段落，保留币种、单位与小计标识。资源容量用数字并列展示实例的已创建数量 / 创建配额，以及 CPU、内存、Workspace 存储的占比与已分配量 / 配额。配额使用率按 80% 和 100% 阈值用语义色与状态文字提示。Agent 状态用密集型 Fluent Table 展示状态与数量，每行一种状态，状态带浅色 Fluent 图标标识，数字右对齐，标题栏显示运行数量 / 总数量。桌面单屏网格顶部用横栏展示资源容量，趋势图与八行状态表并排对齐，继续工作与置顶位于下方。高度充足时年度活动横跨底部，较矮时使用紧凑热力图。长记录进入详情。窄屏可切换到状态区块，低高度窗口按可用高度分页，概览无滚动条。",
      "实例工作台采用实例列表、Agent、工作区三栏，默认比例 1.2:6.8:2；两条分隔线可拖动与键盘调宽。名称支持内联重命名，移除返回与元信息行；实例列表支持真实图标、原生类型状态图标（运行轻呼吸、停止灰化熄灭、故障仅红色感叹号缩放且无晃动红圈、休眠睡姿与 Zz）、中性行背景、柔和蓝色高亮与 1px 渐变选中轮廓、搜索、分页与安全切换；实例列表标题栏仅保留隐藏入口，移除重复的全屏或展开管理按钮，隐藏后在 Agent 标题栏的实例状态后提供恢复列表按钮，与名称、状态同行，不单独占用一行，不依赖原生页面加载或实例运行状态，全屏时仍可达并在恢复时退出全屏及返回列表焦点；实例列表顶部依次提供“创建实例”和“实例管理”，空列表主窗口也提供创建提示及按钮，切换保留无凭据列表快照并为内容提供短暂过渡；普通实例切换不因运行状态或访问元数据重载整页，仅实际隔离预览绑定文档分区，预览后的跨实例隔离继续保留。窄屏用弹窗选择实例。顶部技能管理弹窗与运行管理菜单保留。"
    ],
    "rules": [
      {
        "name": "Semantic Tokens",
        "body": "共享组件使用 Fluent 语义 Token 与公开变体。业务页面通过共享组件或 CM 语义变量消费主题，图表与状态使用各自的公共语义。",
        "section": "colors"
      },
      {
        "name": "Readable Density",
        "body": "正文 14/20、辅助 12/16；通过布局和内容优先级控制密度，不缩字或裁切页面。",
        "section": "typography"
      },
      {
        "name": "Stable Workflows",
        "body": "不改变 API、权限、路由、生命周期和真实刷新机制；表格局部滚动。",
        "section": "layout"
      },
      {
        "name": "Meaningful Elevation",
        "body": "浅层交互卡片与高层浮层分级，不给所有面板叠加浓重阴影。",
        "section": "elevation"
      },
      {
        "name": "Accessible Data",
        "body": "单位、时间范围、图例与文字替代齐全；缺测不是零，运行中不是执行中。",
        "section": "components"
      },
      {
        "name": "Component Scenarios",
        "body": "按组件选型目录核对适用任务、变体和相近组件的选择边界，再检查该组件的状态、尺寸、Token 与动效。",
        "section": "components"
      },
      {
        "name": "UI Acceptance",
        "body": "按 UI 评审清单核对组件与状态、响应式布局、WCAG 2.2 AA 和关键业务回归，并记录实际浏览器结果。",
        "section": "components"
      }
    ],
    "dos": [
      "统一主题与公共组件后再逐页迁移。",
      "保留真实 Logo 与 Agent 图标、完整键盘路径及可见焦点。",
      "核对数据口径、无障碍对比度、缩放及减少动态效果。"
    ],
    "donts": [
      "不把文档更新当作全站上线。",
      "避免页面自建主题、大面积彩色铺底和装饰性渐变。",
      "不以预览常量、缺测补零或循环动画伪造运行情况。"
    ]
  }
