  "narrative": {
    "northStar": "Fluent 2 Web · 清晰、轻盈、有层次的 Agent 工作台",
    "overview": "2026-11-12 用户指定的 CM 整体目标设计语言。中性表面、Web 蓝交互、清晰字体层级、4px 间距、轻层级与功能动效共同组织工作。旧 08 方案归档；本文及 DESIGN.md 不构成已迁移或已部署声明。",
    "keyCharacteristics": [
      "全平台共享语义 Token、组件状态与浮层层级。",
      "保留真实品牌图标、32px Agent 图标和鲜明可读的数据图表。",
      "保留单行表格、紧凑工具栏、侧栏边缘折叠和现有业务语义。",
      "Dashboard 优先继续工作及运行概览；Token 与费用用蓝橙双轴平滑曲线同时显示，用量卡片独立切换时间并局部加载；移除主卡片解释段落，保留币种、单位与小计标识。三个资源表盘、Agent 环图分别表达，环图中心展示运行数量 / 总数量。",
      "实例工作台采用实例列表、Agent、工作区三栏，默认比例 1.2:6.8:2；两条分隔线可拖动与键盘调宽。名称支持内联重命名，移除返回与元信息行；实例列表支持真实图标、原生类型状态图标（运行轻呼吸、停止灰化熄灭、故障仅红色感叹号缩放且无晃动红圈、休眠睡姿与 Zz）、中性行背景、柔和蓝色高亮与 1px 渐变选中轮廓、搜索、分页与安全切换；实例列表标题栏仅保留隐藏入口，移除重复的全屏或展开管理按钮，隐藏后在 Agent 标题栏的实例状态后提供恢复列表按钮，与名称、状态同行，不单独占用一行，不依赖原生页面加载或实例运行状态，全屏时仍可达并在恢复时退出全屏及返回列表焦点；实例列表顶部依次提供“创建实例”和“实例管理”，空列表主窗口也提供创建提示及按钮，切换保留无凭据列表快照并为内容提供短暂过渡；普通实例切换不因运行状态或访问元数据重载整页，仅实际隔离预览绑定文档分区，预览后的跨实例隔离继续保留。窄屏用弹窗选择实例。顶部技能管理弹窗与运行管理菜单保留。"
    ],
    "rules": [
      {
        "name": "Semantic Tokens",
        "body": "使用 Fluent 2 Web 语义映射；CM 图表扩展独立命名，不冒充微软默认 Token。",
        "section": "colors"
      },
      {
        "name": "Readable Density",
        "body": "正文 14/20、辅助 12/16；通过布局和内容优先级控制密度，不缩字或裁切页面。",
        "section": "typography"
      },
      {
        "name": "Stable Workflows",
        "body": "不改变 API、权限、路由、生命周期和真实刷新机制；表格局部滚动。",
        "section": "layout"
      },
      {
        "name": "Meaningful Elevation",
        "body": "浅层交互卡片与高层浮层分级，不给所有面板叠加浓重阴影。",
        "section": "elevation"
      },
      {
        "name": "Accessible Data",
        "body": "单位、时间范围、图例与文字替代齐全；缺测不是零，运行中不是执行中。",
        "section": "components"
      }
    ],
    "dos": [
      "统一主题与公共组件后再逐页迁移。",
      "保留真实 Logo 与 Agent 图标、完整键盘路径及可见焦点。",
      "核对数据口径、无障碍对比度、缩放及减少动态效果。"
    ],
    "donts": [
      "不把文档更新当作全站上线。",
      "不混用旧 08 视觉规则、紫色主题或装饰性全屏玻璃。",
      "不以预览常量、缺测补零或循环动画伪造运行情况。"
    ]
  }
}
