# Copy this file to examples/.env and replace every placeholder before testing.
# Do not commit examples/.env.

NORTHBOUND_BASE_URL=https://<northbound-node-or-domain>:30000
NORTHBOUND_CA_FILE=northbound-ca.crt

NORTHBOUND_USERNAME=<existing-clawmanager-username>
NORTHBOUND_PASSWORD=<existing-clawmanager-password>
NORTHBOUND_OWNER=pro-test-owner

# openclaw, hermes, opencode, or deepseek-harness.
NORTHBOUND_INSTANCE_TYPE=openclaw
NORTHBOUND_INSTANCE_NAME=nb-openclaw-lite-test
NORTHBOUND_INSTANCE_ALIAS=
NORTHBOUND_DESCRIPTION=Northbound OpenClaw Lite acceptance test

NORTHBOUND_WAIT_CREATE=true
NORTHBOUND_POLL_INTERVAL_MS=2000
NORTHBOUND_POLL_TIMEOUT_MS=600000

NORTHBOUND_ENABLE_SHARELINK=false
NORTHBOUND_SHOW_SECRETS=false

# Required only by get and ShareLink commands after an instance is created.
NORTHBOUND_INSTANCE_ID=

# Optional public portal origin used to build an absolute ShareLink URL.
CLAWMANAGER_PUBLIC_BASE_URL=
