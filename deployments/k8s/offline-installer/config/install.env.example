# single-node | cluster
PROFILE=cluster

# SSH is used only for worker nodes. The control-plane is always the local machine.
SSH_USER=clawadmin
SSH_PORT=22
SSH_PRIVATE_KEY=/root/.ssh/clawmanager-installer

# Kubernetes network ranges. They must not overlap host networks.
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12

# Longhorn is used only for PROFILE=cluster.
LONGHORN_DATA_PATH=/var/lib/longhorn
LONGHORN_REPLICAS=3

# ClawManager NodePort used by the offline manifests.
CLAWMANAGER_NODE_PORT=30443

# Timeouts use GNU timeout duration syntax.
NODE_READY_TIMEOUT=15m
CLAWMANAGER_READY_TIMEOUT=20m
